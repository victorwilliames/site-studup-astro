<div id="studup-popup-modal" class="studup-popup-overlay" aria-hidden="true" style="display:none;">
  <div class="studup-popup-backdrop" data-close-popup="635"></div>
  <div class="studup-popup-dialog">
    <button type="button" class="studup-popup-close" data-close-popup="635" aria-label="Fechar">&times;</button>
    <div data-elementor-type="popup" data-elementor-id="635" class="elementor elementor-635 elementor-location-popup" data-elementor-settings="{&quot;a11y_navigation&quot;:&quot;yes&quot;,&quot;timing&quot;:[]}" data-elementor-post-type="elementor_library">
			<div class="elementor-element elementor-element-3cef1c2 e-con-full e-flex e-con e-child" data-id="3cef1c2" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
				<div class="elementor-element elementor-element-a2778f0 elementor-widget elementor-widget-image" data-id="a2778f0" data-element_type="widget" data-e-type="widget" data-widget_type="image.default">
				<div class="elementor-widget-container">
															<img width="645" height="507" src="/assets/wp/logo-studup-vertical.png" class="attachment-full size-full wp-image-1627" alt="" />															</div>
				</div>
				<div class="elementor-element elementor-element-0e83acb elementor-widget elementor-widget-heading" data-id="0e83acb" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
